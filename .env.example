# Hybrid RAG RBAC - Environment Configuration
APP_NAME=hybrid-rag-rbac
APP_ENV=development
LOG_LEVEL=INFO

# Ingestion & Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Hybrid Retrieval (0.0 = pure sparse BM25, 1.0 = pure dense vector)
HYBRID_ALPHA=0.60
RETRIEVAL_TOP_K=10
RERANK_TOP_K=3

# Semantic Cache
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# Security & Guardrails
ENABLE_PII_MASKING=true
ENABLE_INJECTION_DETECTION=true

# Auth. JWT_SECRET_KEY is required when APP_ENV=production (and by docker compose).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Optional pre-shared bearer tokens: {"<token>": ["<role>", <clearance 0-3>]}.
# The demo tokens in src/core/security.py are only loaded when APP_ENV is not production.
API_TOKENS_JSON=
